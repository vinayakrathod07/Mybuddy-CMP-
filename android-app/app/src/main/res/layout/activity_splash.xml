<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:clipChildren="false">

    <!-- Ambient Subtle Glow Rings (Center Depth Particles) -->
    <View
        android:id="@+id/viewGlowRingOuter"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_neumorphic_circle_btn"
        android:alpha="0.15"
        android:scaleX="0.5"
        android:scaleY="0.5" />

    <View
        android:id="@+id/viewGlowRingInner"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_neumorphic_card"
        android:alpha="0.25"
        android:scaleX="0.6"
        android:scaleY="0.6" />

    <!-- Center Logo & Branding Container -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo Frame with Crisp Elevated White Card -->
        <FrameLayout
            android:id="@+id/frameLogoCard"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_card_white_rounded"
            android:elevation="14dp"
            android:padding="22dp">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/mybuddy_symbol_compact"
                android:contentDescription="MyBuddy Symbol" />
        </FrameLayout>

        <!-- Brand Wordmark Text -->
        <TextView
            android:id="@+id/tvSplashBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:text="MyBuddy"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:alpha="0" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Own Your Day • AI Student Life Companion"
            android:textColor="#E4DBFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:alpha="0" />

        <!-- Speech Greeting Pill ("Kya Haal Hai Dost!") -->
        <LinearLayout
            android:id="@+id/layoutGreetingPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_yellow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:alpha="0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ क्या हाल है दोस्त!"
                android:textColor="#1F1A38"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Attribution (Strictly Preserving Developer Credit) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed and Managed by Vinay Rathod"
            android:textColor="#D5C9FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
