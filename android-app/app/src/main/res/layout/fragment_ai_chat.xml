<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_bg">

    <!-- Top Header with Languages and Talk-Back Speaker Toggle -->
    <LinearLayout
        android:id="@+id/topChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <HorizontalScrollView
            android:id="@+id/scrollLanguages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipLangEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_btn_primary_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇬🇧 English"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLangHindi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇮🇳 हिंदी"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chipLangHinglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇮🇳 Hinglish"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chipLangKannada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇮🇳 ಕನ್ನಡ"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chipLangTelugu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇮🇳 తెలుగు"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chipLangTamil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇮🇳 தமிழ்"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chipLangMarathi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇮🇳 मराठी"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chipLangSpanish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_neumorphic_chip_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🇪🇸 Español"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnToggleTalkBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_lime"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="🔊 Voice ON"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Prompt Suggestions (Neumorphic Pills) -->
    <HorizontalScrollView
        android:id="@+id/scrollSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topChatHeader">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/promptDailyCheckIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_btn_primary_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="💬 Daily Check-In"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptRoadmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🗺️ Career Roadmap"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptTodayClasses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="📅 Today's Classes"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="📊 Attendance Risk"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptUrgentTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="⚠️ Urgent Tasks"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptStudyPlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="💡 Plan Study Session"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_lime"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="💧 Drink Water (+15 XP)"
                android:textColor="#1F1A38"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptStrategy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_yellow"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="⚡ Daily Strategy"
                android:textColor="#1F1A38"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptQuiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🎯 Quiz Me"
                android:textColor="@color/electric_violet"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptMnemonic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🧠 Memory Mnemonic"
                android:textColor="@color/cobalt_blue"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptSprint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="⏱️ 20-Min Sprint"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promptGrowthCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neumorphic_chip_idle"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="📈 Growth Diagnostic"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/scrollSuggestions"
        app:layout_constraintBottom_toTopOf="@id/inputBarLayout" />

    <!-- Neumorphic Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/inputBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neumorphic_top_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- AI Vision / Photo Attachment Button -->
        <FrameLayout
            android:id="@+id/btnAttachPhoto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neumorphic_circle_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <!-- Voice Input Microphone Button -->
        <FrameLayout
            android:id="@+id/btnVoiceInput"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_neumorphic_circle_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivMicIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <!-- Inset Input Field -->
        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neumorphic_sunken"
            android:hint="Ask Dost, your AI buddy..."
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <!-- Send Button -->
        <FrameLayout
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neumorphic_circle_primary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
