<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">

    <!-- User Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@color/brand_primary"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvUserContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Assistant Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutAssistantMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:background="@color/white"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAssistantContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slate_900"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/slate_500"
            android:textSize="10sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnTtsRead"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Read Aloud"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/slate_500" />
    </LinearLayout>

</LinearLayout>
