<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/viewColorBar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/brand_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/slate_100"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Monday"
                    android:textColor="@color/slate_700"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubjectCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="CS301"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Operating Systems"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClassDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hall 101 • Dr. Miller"
                android:textColor="@color/slate_500"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClassTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="09:00 - 10:30"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
