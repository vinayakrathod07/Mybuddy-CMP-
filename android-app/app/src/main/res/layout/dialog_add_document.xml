<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neu_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etDocTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Document Title (e.g. Unit 3 Memory Notes)"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDocSubject"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Course Name (e.g. Operating Systems)"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Resource Category"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spDocCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_neumorphic_sunken" />

    <EditText
        android:id="@+id/etDocUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Resource URL or File Link"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDocNotes"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:gravity="top"
        android:hint="Notes, key concepts or description..."
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>

