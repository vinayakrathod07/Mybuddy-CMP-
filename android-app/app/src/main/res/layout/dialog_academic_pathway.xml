<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📈 Student Growth &amp; CGPA Pathway"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CGPA/SGPA goal planner, weak subject diagnostics &amp; academic roadmap"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 1. CGPA / SGPA Goal Planner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🎯 CGPA / SGPA Target Planner"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neumorphic_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Current CGPA:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCurrentCGPA"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_neumorphic_sunken"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:text="7.8"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target Graduation CGPA:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTargetCGPA"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_neumorphic_sunken"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:text="8.5"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remaining Semesters:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRemainingSemesters"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_neumorphic_sunken"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="4"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCalculateSGPA"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neumorphic_btn_primary_idle"
                android:gravity="center"
                android:text="Calculate Required SGPA ⚡"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <!-- Output Box -->
            <LinearLayout
                android:id="@+id/layoutSGPASolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neumorphic_sunken"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvRequiredSGPATitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Average SGPA: 8.85"
                    android:textColor="@color/electric_violet"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRequiredSGPANote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="To jump from 7.8 to 8.5 in 4 semesters, maintain ~8.85 SGPA. Aim for 'A' grades in 4-credit courses!"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Weak Subject Diagnostic -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔍 Weak Subject Diagnostic &amp; AI Action Plan"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutWeakSubjectsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neumorphic_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvWeakSubjectDiagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing subject marks &amp; attendance correlation..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Campus Career Milestone Roadmap -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🎓 Campus Growth Roadmap"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neumorphic_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Tier-1 Placement Eligibility Criteria:"
                android:textColor="@color/electric_violet"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Most high-package companies require minimum 7.5+ CGPA with no active backlogs. Keep attendance strictly >= 75% to prevent debarment."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Continuous Evaluation Strategy (CIA):"
                android:textColor="@color/cobalt_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Internal midterms &amp; assignments contribute 50% to your final GPA. Scoring 18+/20 in internal assessments drastically reduces final exam pressure."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
