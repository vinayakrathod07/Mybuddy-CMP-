<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neu_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Course Name (e.g. Artificial Intelligence)"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etSubjectCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Course Code (e.g. CS401)"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etFaculty"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Faculty / Professor"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTargetPct"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neumorphic_sunken"
        android:hint="Attendance Target % (Default: 75.0)"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

</LinearLayout>

