<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header with Brand Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/mybuddy_symbol_mark"
                android:contentDescription="MyBuddy Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Welcome to MyBuddy!"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Personalize your AI academic companion in 30 seconds"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Main Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_neumorphic_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Institution / College -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏫 College / University"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOnboardingCollege"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neumorphic_sunken"
                android:hint="e.g. Presidency University, Bengaluru"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="14sp" />

            <!-- Degree & Course -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="📚 Course &amp; Branch"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOnboardingCourse"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neumorphic_sunken"
                android:hint="e.g. BCA / B.Tech Computer Science"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="14sp" />

            <!-- Semester & Section Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓️ Semester"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etOnboardingSemester"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_neumorphic_sunken"
                        android:hint="e.g. Semester 5"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_disabled"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️ Section"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etOnboardingSection"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_neumorphic_sunken"
                        android:hint="e.g. 5BCA03"
                        android:inputType="textCapCharacters"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_disabled"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Career Goal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="🚀 Primary Career Goal"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOnboardingGoal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neumorphic_sunken"
                android:hint="e.g. Software Engineer / Campus Placement"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="14sp" />

            <!-- Target Attendance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="🛡️ Target Attendance % (Default 75%)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOnboardingAttendanceTarget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neumorphic_sunken"
                android:hint="75.0"
                android:text="75.0"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Submit Button -->
            <TextView
                android:id="@+id/btnOnboardingSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_neumorphic_btn_primary"
                android:gravity="center"
                android:text="Complete Setup &amp; Launch 🚀"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Skip Button -->
            <TextView
                android:id="@+id/btnOnboardingSkip"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Skip for now (configure later)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:text="Developed and Managed by Vinay Rathod"
            android:textColor="@color/text_disabled"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
