<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@color/lavender_divider" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@color/lavender_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/lavender_primary" />
        </shape>
    </item>
</layer-list>
