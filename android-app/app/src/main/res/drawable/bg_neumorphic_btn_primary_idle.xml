<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient glow shadow layer -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/brand_primary_glow" />
        </shape>
    </item>

    <!-- Gradient Button Face (Electric Violet) -->
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#7952F2"
                android:endColor="#6234EB"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
