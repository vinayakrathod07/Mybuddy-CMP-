<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle shadow -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/lavender_dark_shadow" />
        </shape>
    </item>

    <!-- Clean white / soft surface -->
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_border_subtle" />
        </shape>
    </item>
</layer-list>
