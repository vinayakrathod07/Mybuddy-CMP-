<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle bottom shadow -->
    <item android:top="0dp" android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lavender_dark_shadow" />
        </shape>
    </item>
    <!-- Bar surface with subtle bottom divider -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lavender_card" />
            <stroke android:width="1dp" android:color="@color/lavender_divider" />
        </shape>
    </item>
</layer-list>
