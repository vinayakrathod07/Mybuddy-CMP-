<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right soft shadow -->
    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/lavender_dark_shadow" />
        </shape>
    </item>

    <!-- Top-left highlight -->
    <item
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/lavender_light_shadow" />
        </shape>
    </item>

    <!-- Surface with subtle primary lavender border -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/lavender_card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/lavender_primary" />
        </shape>
    </item>
</layer-list>
