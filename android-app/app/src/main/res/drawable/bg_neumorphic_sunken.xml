<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top-left subtle inset border/shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/lavender_divider" />
        </shape>
    </item>

    <!-- Sunken cavity (Secondary lavender surface #E8E4FA) -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/lavender_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/lavender_divider" />
        </shape>
    </item>
</layer-list>
