<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused input state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/surface_light" />
            <stroke
                android:width="2dp"
                android:color="@color/electric_violet" />
        </shape>
    </item>

    <!-- Normal idle state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/surface_subtle" />
            <stroke
                android:width="1dp"
                android:color="@color/surface_border" />
        </shape>
    </item>
</selector>
