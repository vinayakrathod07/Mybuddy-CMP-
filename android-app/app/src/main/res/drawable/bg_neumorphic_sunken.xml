<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused input state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/white" />
            <stroke
                android:width="1.8dp"
                android:color="@color/lavender_primary" />
        </shape>
    </item>

    <!-- Normal idle state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/neu_sunken" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_sunken_border" />
        </shape>
    </item>
</selector>
