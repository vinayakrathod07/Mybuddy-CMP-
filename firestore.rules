rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AcademiaLife Secure Student Isolation Rules
    // Each student can only read and write their own profile, courses, tasks, attendance, and documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
